POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5433
DATABASE_URL=postgresql://wordly:replace-with-a-long-random-password@127.0.0.1:5433/wordly
APP_ORIGIN=http://localhost:4173
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-at-least-32-random-characters
# Public deployments require an HTTPS APP_ORIGIN. HTTP is allowed only on localhost.
# Optional IP header set/overwritten by your trusted reverse proxy, e.g. x-real-ip.
# Leave blank when directly exposed; a shared client rate limit is used instead.
TRUSTED_IP_HEADER=
